<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Home-screen label shown under the launcher icon. Without the
         chevron — Android renders single-line labels small, where the
         `>` reads as visual noise. The brand wordmark with chevron
         lives everywhere else (fetch button face, share extras, docs). -->
    <string name="app_name">fetchit</string>
    <string name="hint_address">Autonomi address</string>
    <string name="action_fetch">fetch</string>
    <string name="action_retry">retry</string>
    <string name="action_close">close</string>
    <!-- Success message shown for any binary that fetch&gt;it can't
         render natively. Open / Save buttons sit below it. -->
    <string name="binary_success_size">✓ %1$s downloaded</string>
    <string name="binary_success_help">fetch&gt;it doesn\'t have a built-in viewer for this format yet.\nUse open with… or save below.</string>
    <string name="pdf_page_description">PDF page</string>
    <string name="action_open_with">open with…</string>
    <string name="action_save">save…</string>
    <string name="action_share_current">share this address</string>
    <string name="action_share_label">share fetch&gt;it address</string>
    <string name="scan_qr_button_label">scan QR</string>
    <string name="scan_qr_prompt">point at an autonomi:// QR code</string>
    <string name="scan_qr_not_autonomi">that QR didn\'t hold an Autonomi address</string>
    <string name="scan_qr_camera_denied">camera permission needed to scan</string>

    <!-- Smart-paste chip: shown when the clipboard holds an Autonomi
         address and the user hasn\'t already typed something. -->
    <string name="paste_chip_label">📋 paste %1$s ?</string>

    <!-- Network status during in-flight fetches. The "first connection"
         pair is shown only before the first successful fetch (the
         bootstrap warmup is the likely cause of slowness then); after
         that, the neutral "fetching" pair. -->
    <string name="status_connecting">connecting to Autonomi…</string>
    <string name="status_first_connection">first connection takes a moment…</string>
    <string name="status_fetching">fetching…</string>
    <string name="status_still_fetching">still fetching…</string>

    <!-- Friendlier error variants. The technical FetchitException
         message goes to logcat; the user sees something they can act on. -->
    <string name="error_no_client">Couldn\'t reach the network. Check your connection?</string>
    <string name="error_not_found">Couldn\'t find this content on Autonomi.</string>
    <string name="error_timed_out">The network is slow right now. Try again?</string>
    <string name="error_generic">Couldn\'t reach this content. Try again?</string>
    <string name="open_no_app">no app installed to open %1$s</string>
    <string name="save_done">saved</string>
    <string name="save_failed">save failed: %1$s</string>
    <string name="action_play">play</string>
    <string name="action_pause">pause</string>
    <string name="audio_loading">loading audio…</string>
    <string name="error_invalid_address">address must be 64 hex characters</string>
    <string name="error_fetch_prefix">couldn\'t fetch: %1$s</string>
    <string name="image_content_description">fetched image</string>

    <!-- Bookmarks -->
    <string name="bookmark_button_label">bookmarks</string>
    <string name="bookmark_save_dialog_title">save bookmark</string>
    <string name="bookmark_name_hint">name it…</string>
    <string name="bookmark_save_current_with_addr">save current (%1$s…)</string>
    <string name="bookmark_empty">no bookmarks yet — paste an address above, then tap the star to save it</string>
    <string name="bookmark_export">export</string>
    <string name="bookmark_import">import</string>
    <string name="bookmark_share">share</string>
    <string name="bookmark_share_qr">share as QR</string>
    <string name="bookmark_delete">delete</string>
    <string name="bookmark_rename">rename</string>
    <string name="share_qr_title">Share QR code</string>

    <!-- QR preview dialog — in-app modal that mirrors the desktop one. -->
    <string name="qr_preview_qr_alt">QR code for this address</string>
    <string name="qr_preview_copy_address">Copy address</string>
    <string name="qr_preview_copy_url">Copy autonomi://</string>
    <string name="qr_preview_share_image">Share image</string>
    <string name="qr_preview_share_text">Share text</string>
    <string name="qr_preview_copied">Copied!</string>
    <string name="qr_preview_footer">scan with fetch&gt;it on desktop · etchit.io</string>
    <string name="bookmark_export_done">bookmarks exported</string>
    <string name="bookmark_export_failed">export failed: %1$s</string>
    <string name="bookmark_import_done">imported %1$d bookmark(s)</string>
    <string name="bookmark_import_failed">import failed: %1$s</string>

    <!-- Settings sheet -->
    <string name="settings_button_label">settings</string>
    <string name="settings_peer_count_title">network</string>
    <string name="settings_peer_count_value">%1$d peers</string>
    <string name="settings_peer_count_unknown">— peers</string>
    <string name="settings_peer_count_disconnected">not connected</string>
    <string name="settings_peers_header_collapsed">bootstrap peers ▾</string>
    <string name="settings_peers_header_expanded">bootstrap peers ▴</string>
