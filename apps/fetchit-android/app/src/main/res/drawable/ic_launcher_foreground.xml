<?xml version="1.0" encoding="utf-8"?>
<!--
    Brand-spec launcher icon foreground (artifacts/fetchit-brand.html).
    Renders the [>] mark in copper on the ink background supplied by
    the adaptive-icon's background layer. The chevron is the identity:
    never flip, never recolor.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- [ -->
    <path
        android:strokeColor="#c9732b"
        android:strokeWidth="7"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter"
        android:fillColor="#00000000"
        android:pathData="M 36 22 L 22 22 L 22 86 L 36 86" />

    <!-- > -->
    <path
        android:strokeColor="#c9732b"
        android:strokeWidth="7"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter"
        android:fillColor="#00000000"
        android:pathData="M 38 28 L 64 54 L 38 80" />

    <!-- ] -->
    <path
        android:strokeColor="#c9732b"
        android:strokeWidth="7"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter"
        android:fillColor="#00000000"
        android:pathData="M 72 22 L 86 22 L 86 86 L 72 86" />

</vector>
