<?xml version="1.0" encoding="utf-8"?>
<!-- Address card inside a message bubble / feed post: ink panel with a
     hairline ash edge, so the card reads as an object sitting on the
     bubble rather than more text. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="10dp" />
    <solid android:color="?attr/fetchitInk" />
    <stroke
        android:width="1dp"
        android:color="?attr/fetchitAsh" />
</shape>
