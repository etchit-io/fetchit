<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/fetchitInk">

    <!-- Header row: back glyph, peer display name, short id -->
    <LinearLayout
        android:id="@+id/threadHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="?attr/fetchitInk2">

        <Button
            android:id="@+id/threadBackButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="@string/thread_back_glyph"
            android:textColor="?attr/fetchitCopper"
            android:textSize="22sp"
            android:backgroundTint="@android:color/transparent"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:contentDescription="@string/thread_back_desc" />

        <!-- Fediverse correspondent's profile picture. GONE on DM and group
             headers, and on a fedi header with no cached avatar. -->
        <ImageView
            android:id="@+id/threadPeerAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/threadPeerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="?attr/fetchitBone"
            android:fontFamily="monospace"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/threadPeerShortId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="?attr/fetchitAsh"
            android:fontFamily="monospace"
            android:textSize="11sp" />

        <!-- Group member list / moderation entry. Visible only on a group
             thread; GONE for DM and feed headers. -->
        <ImageButton
            android:id="@+id/threadMembersButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_people"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:visibility="gone"
            android:contentDescription="@string/chat_members_desc" />

    </LinearLayout>

    <!-- Go-private strip: shown only on a fediverse DM thread. A full-width,
         clearly-labeled tappable bar (not a nondescript icon) that escalates
         the thread to a private, post-quantum chat. Flips to a quiet pending
         status line after the invite is sent. GONE for DM / group / feed. -->
    <LinearLayout
        android:id="@+id/fediGoPrivateBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fediGoPrivateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/go_private_button"
                android:textColor="?attr/fetchitCopper"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/fediGoPrivateSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/go_private_button_sub"
                android:textColor="?attr/fetchitAsh"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/fediGoPrivateResend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:padding="8dp"
            android:text="@string/go_private_resend"
            android:textColor="?attr/fetchitCopper"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Private-rail-down fallback offer: shown only on a linked (🔒) thread
         while the pump is STOPPED_ERROR. Honest banner + ONE explicit,
         labeled action to send over the open fediverse. Never an automatic
         downgrade — the user makes the privacy call per message. GONE
         otherwise. -->
    <LinearLayout
        android:id="@+id/threadFallbackBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="?attr/fetchitInk2"
        android:visibility="gone">

        <TextView
            android:id="@+id/threadFallbackText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/fetchitBone"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/threadFallbackAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:padding="6dp"
            android:text="@string/thread_fallback_action"
            android:textColor="?attr/fetchitCopper"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Message list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messageList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp" />

    <!-- Staged-image chip: the picture picked for the NEXT send, with its
         size and a remove X. Shown only while an image is staged; a
         private-group or feed screen never shows it (inline images ride
         the DM payload only). -->
    <LinearLayout
        android:id="@+id/threadAttachChip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp"
        android:background="?attr/fetchitInk2"
        android:visibility="gone">

        <ImageView
            android:id="@+id/threadAttachThumb"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/chat_attachment_staged_desc" />

        <TextView
            android:id="@+id/threadAttachLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="?attr/fetchitAsh"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/threadAttachRemove"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:contentDescription="@string/chat_attachment_remove_desc" />

    </LinearLayout>

    <!-- Send row (hidden for feed screen) -->
    <LinearLayout
        android:id="@+id/threadSendRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="?attr/fetchitInk2">

        <!-- Attach a photo. GONE on group + fediverse threads: only the DM
             payload carries an inline image, and offering a control that
             would silently drop the picture is worse than not offering
             it. -->
        <ImageButton
            android:id="@+id/threadAttachButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="2dp"
            android:src="@drawable/ic_image"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:visibility="gone"
            android:contentDescription="@string/chat_attachment_add_desc" />

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/thread_message_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:textColor="?attr/fetchitBone"
            android:textColorHint="?attr/fetchitAsh"
            android:fontFamily="monospace"
            android:textSize="16sp"
            android:background="?attr/fetchitInk3"
            android:padding="10dp" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/chat_send_glyph"
            android:textColor="?attr/fetchitCopper"
            android:textSize="20sp"
            android:backgroundTint="@android:color/transparent"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/thread_send_desc" />

    </LinearLayout>

</LinearLayout>
