<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/fetchitInk">

    <!-- Main content. SwipeRefreshLayout wraps the inner constraint
         layout so pulling down from the top re-runs the last fetch. -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <!-- Top bar: full-width address + ✉ chat mode + QR scan + ★ -->
        <EditText
            android:id="@+id/addressInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/hint_address"
            android:inputType="text"
            android:imeOptions="actionGo"
            android:maxLines="1"
            android:textColor="?attr/fetchitBone"
            android:textColorHint="?attr/fetchitAsh"
            android:fontFamily="monospace"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@+id/modeChatButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/modeChatButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mode_chat_glyph"
            android:textColor="?attr/fetchitCopper"
            android:textSize="20sp"
            android:backgroundTint="?attr/fetchitInk3"
            android:contentDescription="@string/mode_chat_desc"
            android:minWidth="44dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/addressInput"
            app:layout_constraintEnd_toStartOf="@+id/scanButton"
            app:layout_constraintTop_toTopOf="@+id/addressInput" />

        <Button
            android:id="@+id/scanButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌖"
            android:textColor="?attr/fetchitCopper"
            android:textSize="20sp"
            android:backgroundTint="?attr/fetchitInk3"
            android:contentDescription="@string/scan_qr_button_label"
            android:minWidth="44dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/addressInput"
            app:layout_constraintEnd_toStartOf="@+id/bookmarkButton"
            app:layout_constraintTop_toTopOf="@+id/addressInput" />

        <Button
            android:id="@+id/bookmarkButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★"
            android:textColor="?attr/fetchitCopper"
            android:textSize="18sp"
            android:backgroundTint="?attr/fetchitInk3"
            android:contentDescription="@string/bookmark_button_label"
            android:minWidth="44dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/addressInput"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/addressInput" />

        <!-- Smart-paste chip: surfaces when the clipboard holds an
             Autonomi address and the user hasn't already typed
             anything. One tap fills the input + fetches. Hidden in
             every other state. -->
        <TextView
            android:id="@+id/pasteChip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:padding="10dp"
            android:textColor="?attr/fetchitCopperBright"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:gravity="center"
            android:background="@drawable/paste_chip_background"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/addressInput" />

        <!-- Dead-center animated fetch button (WebView-backed). The
             button itself signals state: idle = static "fetch&gt;it" face,
             fetching = ring sweep + running beagle, success = gone
             (content takes the centre, see RenditionRenderer). -->
        <io.etchit.fetchit.FetchButton
            android:id="@+id/fetchButton"
            android:layout_width="150dp"
            android:layout_height="150dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Status text below the centred fetch button during in-flight
             fetches. Times its message: "connecting…" first, then
             "first connection takes a moment…" if the bootstrap drags. -->
        <TextView
            android:id="@+id/fetchStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="?attr/fetchitAsh"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fetchButton" />

        <!-- Rendition surfaces. When the renderer has content the
             fetch button is hidden so these can use the full area. -->
        <TextView
            android:id="@+id/kindText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="?attr/fetchitCopper"
            android:fontFamily="monospace"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/addressInput" />

        <ScrollView
            android:id="@+id/contentScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="48dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/kindText">

            <TextView
                android:id="@+id/contentText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/fetchitBone"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textIsSelectable="true"
                android:padding="6dp" />
        </ScrollView>

        <io.etchit.fetchit.PdfView
            android:id="@+id/pdfView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="48dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/kindText" />

        <io.etchit.fetchit.HtmlView
            android:id="@+id/htmlView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="48dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/kindText" />

        <io.etchit.fetchit.EpubView
            android:id="@+id/epubView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="48dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/kindText" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="48dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@string/image_content_description"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/kindText" />

        <!-- Media3 PlayerView: dead-centred when an audio (and later
             video) rendition is active. Built-in controls render
             play/pause, seek bar, time labels, and ±15s skip. -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone"
            android:background="?attr/fetchitInk2"
            app:show_buffering="when_playing"
            app:auto_show="true"
            app:resize_mode="fit"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Archive view: summary header at top, scrolling entry list in
             the middle, "save archive" button pinned at the bottom of the
             surface (thumb-reachable on mobile regardless of list length).
             Populated by RenditionRenderer.bindArchive via ArchiveView. -->
        <LinearLayout
            android:id="@+id/archiveView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="48dp"
            android:visibility="gone"
            android:background="?attr/fetchitInk"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/kindText">

            <TextView
                android:id="@+id/archiveSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:background="?attr/fetchitInk2"
                android:textColor="?attr/fetchitAsh"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/archiveList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <Button
                android:id="@+id/saveArchiveButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="10dp"
                android:text="@string/archive_save_all"
                android:backgroundTint="?attr/fetchitCopper"
                android:textColor="?attr/fetchitInk" />
        </LinearLayout>

        <!-- Close ✕ — dismisses the rendition and brings the fetch
             button back. Visible only while content is rendered. -->
        <!-- OpaqueBinary actions: appear when the renderer can't
             draw the content natively, give the user a path to
             another app or to the file system. -->
        <LinearLayout
            android:id="@+id/binaryActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="48dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <Button
                android:id="@+id/openWithButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_open_with"
                android:backgroundTint="?attr/fetchitCopper"
                android:textColor="?attr/fetchitInk" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/action_save"
                android:backgroundTint="?attr/fetchitInk3"
                android:textColor="?attr/fetchitCopper" />
        </LinearLayout>

        <!-- Share-current-rendition (↗): visible only while content is
             on screen. Tap → Android share sheet with the autonomi://
             address as text. -->
        <Button
            android:id="@+id/shareButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="↗"
            android:textColor="?attr/fetchitAsh"
            android:textSize="18sp"
            android:backgroundTint="@android:color/transparent"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:visibility="gone"
            android:contentDescription="@string/action_share_current"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/addressInput" />

        <Button
            android:id="@+id/closeButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="✕"
            android:textColor="?attr/fetchitAsh"
            android:textSize="18sp"
            android:backgroundTint="@android:color/transparent"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:visibility="gone"
            android:contentDescription="@string/action_close"
            android:layout_marginTop="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/addressInput" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Chat mode container. Visibility toggled by setMode() in MainActivity.
         The top bar is persistent across all chat screens; ChatModeView
         inflates/swaps screens exclusively inside chatScreenSlot. -->
    <FrameLayout
        android:id="@+id/chatContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="?attr/fetchitInk">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Persistent chat top bar: survives all screen swaps. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/chat_mode_label"
                    android:textColor="?attr/fetchitBone"
                    android:fontFamily="monospace"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/modeBrowseButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_browse_glyph"
                    android:textColor="?attr/fetchitCopper"
                    android:textSize="20sp"
                    android:backgroundTint="?attr/fetchitInk3"
                    android:contentDescription="@string/mode_browse_desc"
                    android:minWidth="44dp" />

            </LinearLayout>

            <!-- Screen swap surface: ChatModeView operates exclusively here. -->
            <FrameLayout
                android:id="@+id/chatScreenSlot"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Messaging tab bar: Chats / People / Feed. Visible only on the
                 three tab roots; ChatModeView hides it inside any open thread. -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/chatTabBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/fetchitInk2"
                app:labelVisibilityMode="labeled"
                app:itemTextColor="?attr/fetchitCopper"
                app:itemIconTint="?attr/fetchitCopper"
                app:menu="@menu/chat_tabs" />

        </LinearLayout>

    </FrameLayout>

    <!-- Persistent settings sheet — peek shows just the drag handle. -->
    <LinearLayout
        android:id="@+id/settingsSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/fetchitInk2"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="36dp"
        app:behavior_hideable="false">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/settings_button_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingTop="0dp">

            <!-- Appearance — three-theme picker, persists + recreates the
                 Activity so the new style applies immediately. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_appearance_title"
                android:textColor="?attr/fetchitAsh"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/themeDarkButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_theme_dark" />

                <Button
                    android:id="@+id/themeDimButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/settings_theme_dim" />

                <Button
                    android:id="@+id/themeLightButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/settings_theme_light" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?attr/fetchitInk3" />

            <!-- Network — always visible, live count -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/settings_peer_count_title"
                android:textColor="?attr/fetchitAsh"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/peerCountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/fetchitAsh"
                android:fontFamily="monospace"
                android:textSize="16sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?attr/fetchitInk3" />

            <!-- Bootstrap peers — collapsible. Header tap toggles body. -->
            <TextView
                android:id="@+id/peersHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="@string/settings_peers_header_collapsed"
                android:textColor="?attr/fetchitAsh"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:id="@+id/peersBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_peers_help"
                    android:textColor="?attr/fetchitAsh"
                    android:fontFamily="monospace"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/peersEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minLines="6"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:textColor="?attr/fetchitBone"
                    android:textColorHint="?attr/fetchitAsh"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:background="?attr/fetchitInk3"
                    android:padding="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/resetPeersButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_reset_peers"
                        android:backgroundTint="?attr/fetchitInk3"
                        android:textColor="?attr/fetchitCopper" />

                    <Button
                        android:id="@+id/savePeersButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="@string/settings_save_peers"
                        android:backgroundTint="?attr/fetchitCopper"
                        android:textColor="?attr/fetchitInk" />
                </LinearLayout>

                <Button
                    android:id="@+id/refreshPeersButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/settings_refresh_peers"
                    android:backgroundTint="?attr/fetchitInk3"
                    android:textColor="?attr/fetchitCopper" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?attr/fetchitInk3" />

            <!-- Chat display name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/settings_chat_title"
                android:textColor="?attr/fetchitAsh"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1" />

            <EditText
                android:id="@+id/chatDisplayNameEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/chat_display_name_hint"
                android:inputType="textPersonName|textNoSuggestions"
                android:maxLines="1"
                android:textColor="?attr/fetchitBone"
                android:textColorHint="?attr/fetchitAsh"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:background="?attr/fetchitInk3"
                android:padding="8dp"
                android:imeOptions="actionDone" />

            <!-- Keep chat connected in the background -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="0dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_chat_keepalive_title"
                        android:textColor="?attr/fetchitBone"
                        android:fontFamily="monospace"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_chat_keepalive_summary"
                        android:textColor="?attr/fetchitAsh"
                        android:fontFamily="monospace"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/chatKeepConnectedSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?attr/fetchitInk3" />

            <!-- Chat: link a device (M6.4) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/settings_link_device_title"
                android:textColor="?attr/fetchitAsh"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_link_device_desc"
                android:textColor="?attr/fetchitAsh"
                android:textSize="12sp" />

            <Button
                android:id="@+id/linkShowCodeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/settings_link_show_code"
                android:backgroundTint="?attr/fetchitCopper"
                android:textColor="?attr/fetchitInk" />

            <Button
                android:id="@+id/linkScanCodeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_link_scan_code"
                android:backgroundTint="?attr/fetchitInk3"
                android:textColor="?attr/fetchitCopper" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?attr/fetchitInk3" />

            <!-- Recovery phrase (identity backup) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/backup_section_header"
                android:textColor="?attr/fetchitAsh"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/backupRevealRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="@string/backup_reveal_row"
                android:textColor="?attr/fetchitCopper"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/backupRestoreRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="@string/backup_restore_row"
                android:textColor="?attr/fetchitCopper"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?attr/fetchitInk3" />

            <TextView
                android:id="@+id/aboutHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="@string/about_settings_row"
                android:textColor="?attr/fetchitCopper"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/settingsVersionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:textColor="?attr/fetchitAsh"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
