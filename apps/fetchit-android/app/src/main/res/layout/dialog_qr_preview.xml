<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen brand-fixed share dialog. The host activity may be on any
  theme (dark / dim / light); this surface always reads as a printed
  card (cream / ink / copper). ScrollView lets the layout cope with
  short phones / landscape; close X dismisses since there's no
  tap-outside region in fullscreen mode.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#f5f2eb">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:gravity="center_horizontal">

        <!-- Top row: close X (right-anchored). -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <ImageButton
                android:id="@+id/qr_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_close"
                android:tint="#0a0a0a" />
        </FrameLayout>

        <!-- Header: fetch>it wordmark — copper chevron between ink fetch / it. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="fetch"
                android:textColor="#0a0a0a"
                android:textStyle="bold"
                android:textSize="20sp"
                android:fontFamily="monospace" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&gt;"
                android:textColor="#c9732b"
                android:textStyle="bold"
                android:textSize="20sp"
                android:fontFamily="monospace" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="it"
                android:textColor="#0a0a0a"
                android:textStyle="bold"
                android:textSize="20sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- QR — rendered into the ImageView at runtime (QrBitmap.renderQrWithLogo). -->
        <ImageView
            android:id="@+id/qr_image"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:background="@android:color/white"
            android:padding="8dp"
            android:contentDescription="@string/qr_preview_qr_alt" />

        <!-- Editable title — pre-filled when the caller passes one
             (etch title / page <title> / filename), but always editable
             so the sharer can override before saving / copying. The
             render-card pipeline reads this value at export time, not
             at dialog open. -->
        <EditText
            android:id="@+id/qr_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#0a0a0a"
            android:textColorHint="#8a8a8a"
            android:textSize="18sp"
            android:textStyle="italic"
            android:gravity="center"
            android:maxLength="60"
            android:maxLines="2"
            android:hint="@string/qr_preview_title_hint"
            android:background="@android:color/transparent"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences|textAutoCorrect"
            tools:text="example title" />

        <!-- Abbreviated 64-hex address (8+…+8). Single line, mono. The full
             hex still lives inside the QR and on the clipboard buttons. -->
        <TextView
            android:id="@+id/qr_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:textColor="#8a8a8a"
            android:textSize="13sp"
            android:textIsSelectable="true"
            android:singleLine="true"
            android:gravity="center"
            tools:text="01234567…cdef0123" />

        <!-- Copy buttons. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/qr_copy_hex"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:maxLines="1"
                android:text="@string/qr_preview_copy_address" />
            <Button
                android:id="@+id/qr_copy_url"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:text="@string/qr_preview_copy_url" />
        </LinearLayout>

        <!-- Image buttons — save PNG to Downloads, or copy PNG to clipboard. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/qr_save_image"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:maxLines="1"
                android:text="@string/qr_preview_save_image" />
            <Button
                android:id="@+id/qr_copy_image"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:text="@string/qr_preview_copy_image" />
        </LinearLayout>

        <!-- Send in chat — only visible when the host passes onSendInChat. -->
        <Button
            android:id="@+id/qr_send_in_chat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:maxLines="1"
            android:text="@string/share_send_in_chat" />

        <!-- Brand footer. Matches the desktop modal's etchit.io copper accent. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/qr_preview_footer"
            android:textColor="#8a8a8a"
            android:textSize="11sp"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
