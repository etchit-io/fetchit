<?xml version="1.0" encoding="utf-8"?>
<!-- Single chat message row. Outbound vs inbound alignment is set
     programmatically by the adapter (gravity + background drawable). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="2dp">

    <!-- Group sender-name label: the sender's identity hue, shown once at the
         top of a consecutive run. Visibility + color set by the adapter; gone
         for DMs, own messages, and follow-on bubbles. Mirrors desktop's
         .chat-bubble__sender. -->
    <TextView
        android:id="@+id/messageSender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="2dp"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/messageBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        android:padding="10dp"
        android:textColor="?attr/fetchitBone"
        android:fontFamily="monospace"
        android:textSize="16sp"
        android:lineSpacingExtra="2dp"
        android:textIsSelectable="true" />

    <TextView
        android:id="@+id/messageMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="?attr/fetchitAsh"
        android:fontFamily="monospace"
        android:textSize="10sp" />

</LinearLayout>
