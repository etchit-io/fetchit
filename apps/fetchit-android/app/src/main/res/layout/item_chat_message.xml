<?xml version="1.0" encoding="utf-8"?>
<!-- Single chat message row. Outbound vs inbound alignment is set
     programmatically by the adapter (gravity + background drawable). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="2dp">

    <!-- Group sender-name label: the sender's identity hue, shown once at the
         top of a consecutive run. Visibility + color set by the adapter; gone
         for DMs, own messages, and follow-on bubbles. Mirrors desktop's
         .chat-bubble__sender. -->
    <TextView
        android:id="@+id/messageSender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="2dp"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- The bubble itself: carries the background drawable and padding so the
         body and its meta line (time, send state) sit inside one rounded
         shape. A timestamp outside the bubble reads as belonging to no
         message in particular. -->
    <LinearLayout
        android:id="@+id/messageBubbleFrame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Inline image attachment (DM only). Sized by the adapter from
             the width/height that rode with the bytes, so the row reserves
             the right shape before anything decodes and the list does not
             jump when it does. Gone on a text-only message. -->
        <ImageView
            android:id="@+id/messageImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:background="?attr/fetchitInk3"
            android:visibility="gone" />

        <TextView
            android:id="@+id/messageBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:textColor="?attr/fetchitBone"
            android:fontFamily="monospace"
            android:textSize="16sp"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="true" />

        <!-- autonomi:// content cards for every address the body mentions.
             Filled by AddressCardBinder; gone when the body has none. Each
             card renders from the address alone — no fetch happens here. -->
        <LinearLayout
            android:id="@+id/messageCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Bottom line inside the bubble: post actions, then the time
             (+ send state on outbound). Kept wrap_content and gravity=end
             so the bubble still hugs its text — a match_parent row here
             would stretch every bubble to the full screen width. The
             action slot is gone unless the row is a fediverse feed post. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="3dp"
            android:layout_marginStart="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Open the conversation under a fediverse feed post. The
                 body is tappable too, but a movement-method tap is
                 invisible to TalkBack and to anyone who does not know it
                 is there, so the action also gets a real control. Gone on
                 every chat row and inside the thread view itself. -->
            <TextView
                android:id="@+id/messageReplies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="32dp"
                android:gravity="center"
                android:textSize="15sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone" />

            <!-- Like toggle for fediverse feed posts. Gone on every chat
                 row: LIT messages have no public reaction concept. -->
            <TextView
                android:id="@+id/messageLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="32dp"
                android:gravity="center"
                android:textSize="15sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone" />

            <TextView
                android:id="@+id/messageMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="280dp"
                android:textAlignment="textEnd"
                android:textColor="?attr/fetchitAsh"
                android:fontFamily="monospace"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
