<?xml version="1.0" encoding="utf-8"?>
<!--
  Instrument Serif (OFL): bundled brand display serif, the Android mirror
  of the desktop's font-display token. Used ONLY for display moments
  (QR-card title, chat empty-state tagline); body chrome stays monospace.
  License ships at assets/fonts/OFL.txt. Converted from the desktop's
  vendored woff2 (same font lineage). See the tokens-v2 parity plan in
  docs/superpowers/plans/.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/instrument_serif_regular" />
    <font
        android:fontStyle="italic"
        android:fontWeight="400"
        android:font="@font/instrument_serif_italic" />
</font-family>
