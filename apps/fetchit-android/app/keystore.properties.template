# Copy this file to `keystore.properties` (gitignored) and fill in
# real values to enable release signing on local builds.
#
# Without a populated `keystore.properties`, release builds fall back
# to debug signing — fine for testing, not OK for distribution.
#
# Generate the keystore with:
#
#   cd apps/fetchit-android/app
#   keytool -genkeypair -v \
#     -keystore fetchit-release.keystore \
#     -alias fetchit \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# For GitHub Actions release builds, the same keystore is encoded as
# base64 and stored in the KEYSTORE_BASE64 repo secret. See
# RELEASING.md.

storeFile=fetchit-release.keystore
storePassword=CHANGE_ME
keyAlias=fetchit
keyPassword=CHANGE_ME
