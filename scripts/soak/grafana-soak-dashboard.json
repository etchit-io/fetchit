{
  "uid": "lit-soak",
  "title": "LIT Soak: DM Outbox Reliability",
  "tags": ["lit", "soak", "chat"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Delivery rate",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "soak_delivery_rate * 100", "datasource": { "type": "prometheus", "uid": "prometheus" } } ],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 99 }, { "color": "green", "value": 99.9 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2, "type": "stat", "title": "Stuck (Sending)",
      "gridPos": { "h": 4, "w": 4, "x": 5, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "soak_stuck", "datasource": { "type": "prometheus", "uid": "prometheus" } } ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3, "type": "stat", "title": "Dup delivered",
      "gridPos": { "h": 4, "w": 4, "x": 9, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "soak_dup_delivered", "datasource": { "type": "prometheus", "uid": "prometheus" } } ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4, "type": "stat", "title": "Orphan receipts",
      "gridPos": { "h": 4, "w": 4, "x": 13, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "soak_orphan_receipts", "datasource": { "type": "prometheus", "uid": "prometheus" } } ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5, "type": "stat", "title": "Collector age (s)",
      "gridPos": { "h": 4, "w": 7, "x": 17, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "time() - soak_collector_updated_timestamp_seconds", "datasource": { "type": "prometheus", "uid": "prometheus" } } ],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 90 }, { "color": "red", "value": 180 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Sent vs Delivered (cumulative)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "soak_sent_total", "legendFormat": "sent", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "B", "expr": "soak_delivered_total", "legendFormat": "delivered", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 7, "type": "timeseries", "title": "Send throughput (msg/min)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "rate(soak_sent_total[5m]) * 60", "legendFormat": "sent/min", "datasource": { "type": "prometheus", "uid": "prometheus" } } ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 8, "type": "timeseries", "title": "Time-to-delivery (s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "soak_ttd_p50_seconds", "legendFormat": "p50", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "B", "expr": "soak_ttd_p95_seconds", "legendFormat": "p95", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "C", "expr": "soak_ttd_max_seconds", "legendFormat": "max", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 0 } }, "overrides": [] }
    },
    {
      "id": 9, "type": "timeseries", "title": "Inbound unique vs sent",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "soak_inbound_unique", "legendFormat": "inbound unique", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "B", "expr": "soak_sent_total", "legendFormat": "sent", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 20, "type": "row", "title": "Groups (private MLS) -- same-LAN PROVEN; cross-NAT Welcome blocked upstream",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 }, "collapsed": false, "panels": []
    },
    {
      "id": 21, "type": "stat", "title": "Group join converged",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "soak_group_join_converged", "datasource": { "type": "prometheus", "uid": "prometheus" } } ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 22, "type": "stat", "title": "Group delivered+decrypted",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "soak_group_delivered_total", "datasource": { "type": "prometheus", "uid": "prometheus" } } ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 23, "type": "stat", "title": "Group decrypt fails",
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "soak_group_decrypt_fail_total", "datasource": { "type": "prometheus", "uid": "prometheus" } } ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 24, "type": "stat", "title": "x0xd peers (group fleet)",
      "gridPos": { "h": 4, "w": 9, "x": 15, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "soak_group_x0xd_peers", "legendFormat": "{{box}}", "datasource": { "type": "prometheus", "uid": "prometheus" } } ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 1 }, { "color": "green", "value": 4 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    },
    {
      "id": 25, "type": "timeseries", "title": "Group sent vs delivered (cumulative)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "soak_group_sent_total", "legendFormat": "group sent", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "B", "expr": "soak_group_delivered_total", "legendFormat": "group delivered+decrypted", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 30, "type": "row", "title": "Launch Test Matrix -- lane status (green=live, yellow=pending, red=blocked)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }, "collapsed": false, "panels": []
    },
    {
      "id": 31, "type": "stat", "title": "DM outbox (wss)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "soak_delivery_rate * 100", "datasource": { "type": "prometheus", "uid": "prometheus" } } ],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 99 }, { "color": "green", "value": 99.9 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 32, "type": "stat", "title": "Groups same-LAN",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "soak_group_join_converged", "datasource": { "type": "prometheus", "uid": "prometheus" } } ],
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "LIVE", "color": "green", "index": 1 } } } ] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 33, "type": "stat", "title": "Groups cross-NAT",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "soak_test_status{lane=\"groups_crossnat\"}", "datasource": { "type": "prometheus", "uid": "prometheus" } } ],
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "-1": { "text": "BLOCKED (upstream)", "color": "red", "index": 0 }, "0": { "text": "PENDING", "color": "yellow", "index": 1 }, "1": { "text": "LIVE", "color": "green", "index": 2 } } } ] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 34, "type": "stat", "title": "Group auto-import",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "soak_test_status{lane=\"groups_autoimport\"}", "datasource": { "type": "prometheus", "uid": "prometheus" } } ],
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "-1": { "text": "BLOCKED", "color": "red", "index": 0 }, "0": { "text": "PENDING", "color": "yellow", "index": 1 }, "1": { "text": "LIVE", "color": "green", "index": 2 } } } ] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 35, "type": "stat", "title": "Fedi exerciser",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "soak_test_status{lane=\"fedi_exerciser\"}", "datasource": { "type": "prometheus", "uid": "prometheus" } } ],
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "-1": { "text": "BLOCKED", "color": "red", "index": 0 }, "0": { "text": "PENDING", "color": "yellow", "index": 1 }, "1": { "text": "LIVE", "color": "green", "index": 2 } } } ] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 36, "type": "stat", "title": "Wire v2<->v3 skew",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "soak_test_status{lane=\"wire_v2v3_skew\"}", "datasource": { "type": "prometheus", "uid": "prometheus" } } ],
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "-1": { "text": "BLOCKED", "color": "red", "index": 0 }, "0": { "text": "PENDING", "color": "yellow", "index": 1 }, "1": { "text": "LIVE", "color": "green", "index": 2 } } } ] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 37, "type": "stat", "title": "Denylist e2e",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "soak_test_status{lane=\"denylist_e2e\"}", "datasource": { "type": "prometheus", "uid": "prometheus" } } ],
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "-1": { "text": "BLOCKED", "color": "red", "index": 0 }, "0": { "text": "PENDING", "color": "yellow", "index": 1 }, "1": { "text": "LIVE", "color": "green", "index": 2 } } } ] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 38, "type": "stat", "title": "Inbound-gate enforce",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "soak_test_status{lane=\"inbound_gate\"}", "datasource": { "type": "prometheus", "uid": "prometheus" } } ],
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "-1": { "text": "BLOCKED", "color": "red", "index": 0 }, "0": { "text": "PENDING", "color": "yellow", "index": 1 }, "1": { "text": "LIVE", "color": "green", "index": 2 } } } ] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    }
  ]
}
